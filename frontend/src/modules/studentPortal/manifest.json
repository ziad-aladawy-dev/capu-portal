{
  "id": "studentPortal",
  "name": "Student Portal",
  "version": "1.0.0",
  "coreVersionRequired": "1.0.0",
  "routes": [
    {
      "path": "/student",
      "component": "Navigate",
      "props": { "to": "/student/dashboard", "replace": true },
      "permission": "student.dashboard.view",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/dashboard",
      "component": "StudentDashboard",
      "permission": "student.dashboard.view",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/profile",
      "component": "StudentProfile",
      "permission": "student.profile.view",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/courses",
      "component": "StudentCourses",
      "permission": "student.courses.view",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/courses/register",
      "component": "CourseRegistration",
      "permission": "student.courses.register",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/grades",
      "component": "StudentGrades",
      "permission": "student.grades.view",
      "moduleId": "studentPortal"
    },
    {
      "path": "/student/schedule",
      "component": "StudentSchedule",
      "permission": "student.schedule.view",
      "moduleId": "studentPortal"
    }
  ],
  "menuItems": [
    {
      "category": "Student",
      "label": "Dashboard",
      "path": "/student/dashboard",
      "icon": "LayoutDashboard",
      "permission": "student.dashboard.view"
    },
    {
      "category": "Student",
      "label": "My Courses",
      "path": "/student/courses",
      "icon": "BookOpen",
      "permission": "student.courses.view"
    },
    {
      "category": "Student",
      "label": "My Grades",
      "path": "/student/grades",
      "icon": "FileText",
      "permission": "student.grades.view"
    },
    {
      "category": "Student",
      "label": "Schedule",
      "path": "/student/schedule",
      "icon": "CalendarRange",
      "permission": "student.schedule.view"
    },
    {
      "category": "Student",
      "label": "Profile",
      "path": "/student/profile",
      "icon": "UserCog",
      "permission": "student.profile.view"
    }
  ],
  "permissions": {
    "resources": [
      "student.dashboard.view",
      "student.profile.view",
      "student.profile.edit",
      "student.courses.view",
      "student.courses.register",
      "student.grades.view",
      "student.schedule.view"
    ]
  }
}
