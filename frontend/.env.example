# ─────────────────────────────────────────────────────────────
# capu-portal frontend — environment template
# Copy to .env.development / .env.production and fill in.
# Vite only exposes variables prefixed with VITE_ to the client.
# Secrets must NEVER go here (this file is committed).
# ─────────────────────────────────────────────────────────────

# Backend REST API base. Currently the only var consumed in code
# (src/core/api/apiClient.js). Include the trailing /api.
VITE_API_BASE_URL=http://localhost:5256/api

# Real-time channel (notifications, seat availability). Phase 8.
VITE_WS_URL=ws://localhost:5256/ws

# Payments are processed by the BACKEND, which integrates with the
# HU Treasury System (Mastercard / Bank Misr / eFinance). The frontend
# calls /api/payments/* and is redirected using the RedirectUrl returned
# by Treasury — there is no separate frontend payment-gateway host.

# Error monitoring (Phase 14). Empty = disabled.
VITE_SENTRY_DSN=

# Injected at build time from package.json.
VITE_APP_VERSION=$npm_package_version

# development | staging | production
VITE_DEPLOY_ENV=development

# Enable MSW / mock data layer (Phase 12).
VITE_ENABLE_MOCKS=true

# Default UI language. Arabic-first per i18n fallbackLng.
VITE_DEFAULT_LNG=ar
