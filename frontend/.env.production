# Production build values. Real secrets (e.g. Sentry DSN) should be
# injected by the CI/CD pipeline via .env.production.local or the
# deploy environment, not committed here.

# Served same-origin behind the gateway/nginx reverse proxy.
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_SENTRY_DSN=
VITE_APP_VERSION=$npm_package_version
VITE_DEPLOY_ENV=production
VITE_ENABLE_MOCKS=false
VITE_DEFAULT_LNG=ar
