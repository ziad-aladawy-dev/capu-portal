<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CapitalUniversity.Sync.Host</RootNamespace>
    <AssemblyName>CapitalUniversity.Sync.Host</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>capu-sync-host-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapitalUniversity.Sync.Abstractions\CapitalUniversity.Sync.Abstractions.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Infrastructure\CapitalUniversity.Sync.Infrastructure.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Persistence\CapitalUniversity.Sync.Persistence.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Student\CapitalUniversity.Sync.Student.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Staff\CapitalUniversity.Sync.Staff.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Courses\CapitalUniversity.Sync.Courses.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Finance\CapitalUniversity.Sync.Finance.csproj" />
    <ProjectReference Include="..\CapitalUniversity.Sync.Schedules\CapitalUniversity.Sync.Schedules.csproj" />
    <!-- Core.Infrastructure is needed for the CoreDbContext + CoreWriteGateway
         registration at composition time. Sync.Host is the only sync-side place
         that touches Core.Infrastructure; per-module sync projects must not. -->
    <ProjectReference Include="..\..\2.Core\CapitalUniversity.Core.Infrastructure\CapitalUniversity.Core.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
  </ItemGroup>

</Project>
