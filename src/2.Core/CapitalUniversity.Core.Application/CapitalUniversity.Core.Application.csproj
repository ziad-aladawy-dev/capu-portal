<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- RMG089: nullable source → non-nullable target. The PATCH-style
		     UpdateEntity mappers set AllowNullPropertyAssignment = false so
		     null sources don't overwrite the entity; the analyzer still flags
		     the type mismatch as INFO. Suppress globally for this project. -->
		<NoWarn>$(NoWarn);RMG089</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
		<PackageReference Include="Riok.Mapperly" Version="5.0.0-next.7" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CapitalUniversity.Core.Abstractions\CapitalUniversity.Core.Abstractions.csproj" />
		<ProjectReference Include="..\CapitalUniversity.Core.Domain\CapitalUniversity.Core.Domain.csproj" />
	</ItemGroup>
</Project>